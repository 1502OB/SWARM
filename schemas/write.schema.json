{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "swarm writer result (<task-id>.write.json, written by revit-writer / acad-writer)",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "task_id", "status", "executed_at", "items", "post_warnings", "error"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["success", "failed", "rolled_back", "invalid_manifest", "already_applied"]},
    "executed_at": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "result": {"type": "string"}
        }
      }
    },
    "post_warnings": {"type": ["integer", "null"]},
    "error": {"type": ["string", "null"]}
  }
}
