{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "swarm expected post-state (<task-id>.expected.json, written by scripter, read by verifier)",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "task_id", "items"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1, "pattern": "^[A-Z][A-Z0-9]{1,5}-[A-Z0-9]+-T[0-9]+[a-z0-9]*$",
                "description": "same pattern as task.schema.json; must equal the task_id of the sibling <task-id>.task.json"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "check", "expected_value"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "check": {"type": "string", "minLength": 1},
          "expected_value": {}
        }
      }
    }
  }
}
