;;; test_swarm_lib.lsp - tests for swarm_lib.lsp, run headless on a scratch drawing copy:
;;;   python C:/Users/Jeremy/swarm/tools/lsp_dryrun.py C:/Users/Jeremy/swarm/library/acad/test_swarm_lib.lsp <any.dwg> SWLTEST --run
;;; PLAN = pure-LISP tests; RUN = tests that entmake test geometry far from the drawing (x=1e6) on the copy only.
;;; Each returns "pass=<n> fail=<n> | <failed names>". ActiveX-only helpers ([AX]) are not tested here.

(defun swlt:check (name ok)
  (if ok (setq SWLT:PASS (1+ SWLT:PASS)) (setq SWLT:FAIL (1+ SWLT:FAIL) SWLT:BAD (cons name SWLT:BAD)))
  ok)
(defun swlt:report ()
  (strcat "pass=" (itoa SWLT:PASS) " fail=" (itoa SWLT:FAIL)
          (if SWLT:BAD (strcat " | failed: " (swl:join (reverse SWLT:BAD) ",")) "")))

(defun c:SWLTEST-PLAN (/ vp b)
  (setq SWLT:PASS 0 SWLT:FAIL 0 SWLT:BAD nil)
  (swlt:check "join" (= (swl:join (list "a" "b" "c") ",") "a,b,c"))
  (swlt:check "join-empty" (= (swl:join nil ",") ""))
  (swlt:check "san-newline" (= (swl:san (strcat "a" (chr 10) "b" (chr 13) (chr 9) "\"q\"")) "a | b 'q'"))
  (swlt:check "result" (= (swl:result 2 1 0 (list "1A" "1B") "ok") "done=2 skipped=1 failed=0 | ids=1A,1B | ok"))
  (swlt:check "result-one-line" (not (vl-string-search (chr 10) (swl:result 1 0 0 nil (strcat "x" (chr 10) "y")))))
  (swlt:check "norm" (equal (swl:norm (list 5 1) (list 2 4)) (list 2 1 5 4)))
  (swlt:check "pad" (equal (swl:pad (list 0 0 1 1) 0.5) (list -0.5 -0.5 1.5 1.5)))
  (swlt:check "union" (equal (swl:union (list 0 0 1 1) (list 2 -1 3 0)) (list 0 -1 3 1)))
  (swlt:check "inbox" (and (swl:inbox (list 1 1) (list 0 0 2 2)) (not (swl:inbox (list 3 1) (list 0 0 2 2)))))
  (swlt:check "ovl" (and (swl:ovl (list 0 0 2 2) (list 1 1 3 3)) (not (swl:ovl (list 0 0 1 1) (list 1 1 2 2)))))
  (swlt:check "close" (and (swl:close 1.0 1.004 0.005) (not (swl:close 1.0 1.01 0.005))))
  (swlt:check "uniq" (equal (swl:uniq (list "a" "b" "a" "c" "b")) (list "a" "b" "c")))
  (swlt:check "seghit-inside" (swl:seghit (list 1 1) (list 5 5) (list 0 0 2 2)))
  (swlt:check "seghit-crossing" (swl:seghit (list -1 1) (list 3 1) (list 0 0 2 2)))
  (swlt:check "seghit-miss" (not (swl:seghit (list -1 3) (list 3 3) (list 0 0 2 2))))
  (swlt:check "vtxbox" (equal (swl:vtxbox (list (cons 10 (list 1 2)) (cons 10 (list 4 -1)))) (list 1 -1 4 2)))
  (setq b (list 0.0 0.0 1.0 0.5))
  (swlt:check "cloudpts-count" (= (length (swl:cloudpts b 0.25)) 12))
  (swlt:check "cloudpts-first-BL" (equal (car (swl:cloudpts b 0.25)) (list 0.0 0.0)))
  ;; synthetic viewport: paper centre (10,10), view centre (100,200), target 0, scale k = 0.5
  (setq vp (list (list 10.0 10.0) (list 0.0 0.0 0.0) (list 100.0 200.0) 0.5 (list 5.0 5.0 15.0 15.0)))
  (swlt:check "ms->ps" (equal (swl:ms->ps vp (list 110.0 210.0)) (list 15.0 15.0) 1e-9))
  (swlt:check "ps->ms" (equal (swl:ps->ms vp (list 15.0 15.0)) (list 110.0 210.0) 1e-9))
  (swlt:check "roundtrip" (equal (swl:ps->ms vp (swl:ms->ps vp (list 97.3 188.1))) (list 97.3 188.1) 1e-9))
  (swlt:check "box->ms" (equal (swl:box->ms vp (list 5.0 5.0 15.0 15.0)) (list 90.0 190.0 110.0 210.0) 1e-9))
  (swlt:check "inside-vp" (and (swl:inside-vp vp (list 6 6 8 8)) (not (swl:inside-vp vp (list 6 6 16 8)))))
  (swlt:check "best-spot-first-clear"
    (equal (car (swl:best-spot (list (list 0 0 1 1) (list 5 5 6 6)) (function (lambda (bx) (if (= (car bx) 0) (list "h1") nil)))))
           (list 5 5 6 6)))
  (swlt:check "queue-refuses-erase" (wcmatch (swl:queue-command "_.ERASE ALL ") "ABORT*"))
  (swlt:check "words" (equal (swl:words "_.-XREF A file.dwg") (list "_.-XREF" "A" "file.dwg")))
  (swlt:report))

(defun c:SWLTEST-RUN (/ x0 l1 l2 t1 h1 c ed ck hits)
  (setq SWLT:PASS 0 SWLT:FAIL 0 SWLT:BAD nil x0 1000000.0)
  ;; two lines: one crossing the test box, one far away; a text with known values
  (setq l1 (progn (entmake (list '(0 . "LINE") '(410 . "Model") '(8 . "0") (list 10 (- x0 5) 1.0 0.0) (list 11 (+ x0 5) 1.0 0.0))) (entlast)))
  (setq l2 (progn (entmake (list '(0 . "LINE") '(410 . "Model") '(8 . "0") (list 10 (+ x0 100) 50.0 0.0) (list 11 (+ x0 101) 51.0 0.0))) (entlast)))
  (setq t1 (progn (entmake (list '(0 . "TEXT") '(410 . "Model") '(8 . "0") (list 10 x0 20.0 0.0) '(40 . 2.5) '(1 . "ZURN 375AST"))) (entlast)))
  (setq h1 (cdr (assoc 5 (entget t1))))
  (setq hits (swl:clash "Model" (list (- x0 1) 0.0 (+ x0 1) 2.0) nil 0.0 2000))
  (swlt:check "clash-crossing-line" (member (cdr (assoc 5 (entget l1))) hits))
  (swlt:check "clash-ignores-far-line" (not (member (cdr (assoc 5 (entget l2))) hits)))
  (swlt:check "clash-skip" (not (member (cdr (assoc 5 (entget l1)))
                                        (swl:clash "Model" (list (- x0 1) 0.0 (+ x0 1) 2.0) (list (cdr (assoc 5 (entget l1)))) 0.0 2000))))
  (swlt:check "preflight-ok" (null (swl:preflight (list (list h1 1 "ZURN 375AST" nil) (list h1 40 2.5 1e-9)
                                                        (list h1 10 (list x0 20.0) 0.001)))))
  (swlt:check "preflight-text-changed" (wcmatch (swl:preflight (list (list h1 1 "OTHER" nil))) "*planned*"))
  (swlt:check "preflight-moved" (wcmatch (swl:preflight (list (list h1 10 (list x0 25.0) 0.001))) "*moved*"))
  (swlt:check "preflight-missing" (wcmatch (swl:preflight (list (list "FFFFFF" 1 "x" nil))) "*missing*"))
  (setq c (swl:entmake-cloud (swl:pad (list x0 30.0 (+ x0 2.0) 31.0) 0.1) 0.34 -0.52 "0" "Model"))
  (swlt:check "cloud-entmake" c)
  (if c (progn (setq ck (swl:cloud-check (entget c) -0.52))
               (swlt:check "cloud-clockwise-closed" (car ck))
               (swlt:check "cloud-vertex-box" (equal (cadr ck) (list (- x0 0.1) 29.9 (+ x0 2.1) 31.1) 1e-6))))
  (swlt:check "cloud-check-rejects-wrong-bulge" (if c (not (car (swl:cloud-check (entget c) 0.52))) nil))
  (swlt:report))

(princ)
