{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__revit-mcp__.*|mcp__autocad-mcp__.*|mcp__Bluebeam__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/orchestrator_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$HOME/.claude/hooks/lsp_lint_hook.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
